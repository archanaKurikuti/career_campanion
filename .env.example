# Database Configuration
DB_URL=jdbc:mysql://localhost:3307/career_companion?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me

# JWT Authentication Secret & Expiration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Google Gemini AI Integration Key
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Application Server Port
PORT=8080

# Optional OAuth2 Credentials (Google / GitHub)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
